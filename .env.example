# 前端：正式部署默认走 https://ai.liutongxue.com.cn 同域 /api/chat，通常不需要配置这个变量
# 只有当前端临时部署在其他域名时，才显式指定 API 基地址
# 例子：VITE_JOBS_CHAT_API_BASE_URL=https://ai.liutongxue.com.cn
VITE_JOBS_CHAT_API_BASE_URL=

# 前端：特殊调试场景下可直接指定完整 /api/chat 地址；优先级高于 VITE_JOBS_CHAT_API_BASE_URL
# 例子：VITE_CHAT_API_URL=https://ai.liutongxue.com.cn/api/chat
VITE_CHAT_API_URL=

# 构建期：当前构建实际部署域名；smoke-check 也默认使用这个地址
# 正式构建例子：VITE_SITE_URL=https://ai.liutongxue.com.cn
# TEST 构建例子：VITE_SITE_URL=https://test.liutongxue.com.cn
VITE_SITE_URL=https://ai.liutongxue.com.cn

# 构建期：canonical / og:url / 结构化数据使用的正式 canonical 域名
# 正式与 TEST 构建通常都保持为正式域名
# 例子：VITE_CANONICAL_SITE_URL=https://ai.liutongxue.com.cn
VITE_CANONICAL_SITE_URL=https://ai.liutongxue.com.cn

# 后端：Vercel / 本地 API 所需的真实模型配置（OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 后端：只在服务端使用的 GitHub 仓库只读令牌；不要添加 VITE_ 前缀。
DIGITAL_HUMAN_GITHUB_TOKEN=

# 允许跨域调用 API 的前端来源，多个地址用英文逗号分隔
# 如果 TEST / 预览域名也要访问 API，需要把 TEST 域名显式加入
# 例子：ALLOWED_ORIGINS=https://ai.liutongxue.com.cn,https://dosliu.github.io,http://localhost:5173
ALLOWED_ORIGINS=

# 登录暂时关闭。确认聚合服务可用并配齐登录变量后，可设为 true 恢复。
AUTH_LOGIN_ENABLED=false

# 大恩聚合登录（仅在恢复登录时使用）
# 文档里的统一接口地址，默认就是大恩 connect.php
DAEN_CONNECT_URL=https://u.daenwl.com/connect.php
# 当前准备开放的登录方式，多个用英文逗号分隔
DAEN_ENABLED_TYPES=qq,baidu
# 大恩应用 appid / appkey（真实值请只放环境变量，不要提交进仓库）
DAEN_APP_ID=
DAEN_APP_KEY=
# 这里的回调真源已锁定为 /api/auth/callback；推荐直接填写站点 origin 或完整同源 URL
# 例子：https://ai.liutongxue.com.cn 或 https://ai.liutongxue.com.cn/api/auth/callback
# 即使误填旧的 daen route 回调地址，运行时也会自动收敛到 /api/auth/callback
DAEN_AUTH_CALLBACK_URL=

# session / redirect
# 登录成功后默认回到人物选择页；如果从具体人物页发起登录，会优先回跳原页面
AUTH_LOGIN_SUCCESS_URL=/figures/
# 退出登录后回站地址
AUTH_LOGOUT_REDIRECT_URL=/figures/
AUTH_SESSION_COOKIE_NAME=liutongxue_session
AUTH_STATE_COOKIE_NAME=liutongxue_auth_state
AUTH_SESSION_TTL_SECONDS=604800
# 已登录账号的人物对话默认每日限额
AUTH_DAILY_LIMIT=10

# 人物对话限额（兼容 Upstash / Vercel KV REST）
# - AUTH_KV_ENABLED=true 且下面两个 REST 变量都存在时：服务端按账号 subject 执行“每日 10 次”
# - 游客使用同一存储，按签名游客标识累计 5 次，标识有效期 1 年，跨人物共享
# - 游客需同时配置 AUTH_SESSION_SECRET；配置不完整或存储故障时不调用真实模型
# - 登录账号同样在配置不完整、计数存储故障或返回异常数据时暂停真实模型调用
# 至少 32 个字符的随机字符串，用来签名游客 Cookie 和登录会话。关闭登录后仍需保留。
AUTH_SESSION_SECRET=
AUTH_KV_ENABLED=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 可选，仅保留给其他 KV 用途；人物对话限额当前走 REST
KV_URL=
